# Template for .streamlit/secrets.toml — sign-in (OIDC) and the access allowlist.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Then fill in real values. Never commit .streamlit/secrets.toml (it is gitignored),
# and Claude Code cannot write it (.claude/hooks/block-secrets.sh). Streamlit never
# loads this .example file.
#
# Unedited, this template FAILS CLOSED: its placeholder cookie_secret is refused, so
# the app shows "Sign-in is unavailable" (the reason is logged to the server's
# stderr) until you replace it.

# The Deepgram key, for hosts with no .env (e.g. Streamlit Community Cloud). A
# top-level value like this is also copied into the process environment.
# DEEPGRAM_API_KEY = "..."

# Do NOT put NOVA_ALLOW_ANONYMOUS here, or in .env: finding it in either file blocks
# the app ("Sign-in is unavailable"). Anonymous mode (no sign-in) is for local
# development only, and is set in the process environment of that one command:
#   NOVA_ALLOW_ANONYMOUS=1 uv run streamlit run streamlit_app.py

[auth]
# Must end in /oauth2callback, and be registered as a redirect URI with your
# identity provider. Use your deployed URL in production.
redirect_uri = "http://localhost:8501/oauth2callback"
# Signs the login cookie: anyone who knows it can forge a sign-in. Use at least 32
# random characters, generated with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "CHANGE-ME"

# The default provider, shown as a "Sign in" button. Google Workspace shown here; the
# app also requires a Google account's hosted domain ("hd") to be allowlisted, so a
# personal Google account registered on a work address is refused.
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Shared workstations: Sign out in the app may not end the identity-provider session
# (Google's doesn't), so the next person could click straight back in as the last
# one. Providers that honor prompt = "login" (Entra, Okta, Auth0) can be made to ask
# for credentials on every sign-in — add to that provider's table, or flat here for
# the default provider:
#   client_kwargs = { prompt = "login" }
# Google has no such prompt; there, users must also sign out of Google itself.

# More providers: each [auth.<name>] table adds a "Sign in with <Name>" button. Names
# can't contain "_", and "default" is reserved for the flat provider above.
#
# Microsoft Entra ID: use your TENANT-SPECIFIC metadata URL (never /common or
# /organizations) — it pins sign-in to your tenant. Entra ID tokens carry no
# "email_verified" claim, so also list "microsoft" in unverified_email_providers below.
# [auth.microsoft]
# client_id = "your-application-id"
# client_secret = "your-client-secret"
# server_metadata_url = "https://login.microsoftonline.com/your-tenant-id/v2.0/.well-known/openid-configuration"
# client_kwargs = { prompt = "login" }

[access]
# Exact email domains allowed to sign in, lowercase. No wildcards and no subdomain
# matching: list each subdomain you want to allow. An empty list refuses everyone.
allowed_email_domains = ["hospital.example"]
# Providers whose ID tokens may omit "email_verified" (e.g. ["microsoft"] for Entra).
# "default" names the flat provider above. Tokens from any other provider must say
# the email is verified.
unverified_email_providers = []
